{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-sky-physics.blush-eel-3740.chatgpt.site/data/model-manifest.schema.json",
  "title": "Milky Way internal-view architecture manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "modelId",
    "displayName",
    "targetScientificClaim",
    "currentScientificClaim",
    "status",
    "canonicalFrame",
    "rendererGate",
    "modelFamilies",
    "massLedger",
    "phaseSpace",
    "stellarPopulation",
    "dust",
    "radiation",
    "observer",
    "validation",
    "artifactContract"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modelId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "targetScientificClaim": { "type": "string", "minLength": 1 },
    "currentScientificClaim": { "type": "string", "minLength": 1 },
    "status": { "const": "architecture-only" },
    "canonicalFrame": {
      "type": "object",
      "required": [
        "origin",
        "handedness",
        "xDefinition",
        "yDefinition",
        "zDefinition",
        "solarPlanarUiAnchorParsec",
        "azimuthDefinition",
        "observerRadiusRangeParsec",
        "frameWarning"
      ],
      "properties": {
        "origin": { "type": "string" },
        "handedness": { "const": "right-handed" },
        "xDefinition": { "type": "string" },
        "yDefinition": { "type": "string" },
        "zDefinition": { "type": "string" },
        "solarPlanarUiAnchorParsec": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "azimuthDefinition": { "type": "string" },
        "observerRadiusRangeParsec": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "frameWarning": { "type": "string" }
      }
    },
    "rendererGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unlocked", "policy", "forbiddenDirectControls"],
      "properties": {
        "unlocked": { "const": false },
        "policy": { "const": "all-required-capabilities-must-be-validated" },
        "forbiddenDirectControls": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modelFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["modelId", "role", "status"],
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "massLedger": {
      "type": "object",
      "required": ["combinationPolicy", "forbidPotentialBlendingByRadius", "components", "requiredAssertions"],
      "properties": {
        "combinationPolicy": { "type": "string" },
        "forbidPotentialBlendingByRadius": { "const": true },
        "components": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "owner", "retained", "excluded"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "retained": { "type": "string", "minLength": 1 },
              "excluded": { "type": "string", "minLength": 1 }
            }
          }
        },
        "requiredAssertions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phaseSpace": { "type": "object" },
    "stellarPopulation": { "type": "object" },
    "dust": { "type": "object" },
    "radiation": { "type": "object" },
    "observer": { "type": "object" },
    "validation": { "type": "object" },
    "artifactContract": {
      "type": "object",
      "required": [
        "modelManifestSchema",
        "scientificArtifactSchema",
        "validationReceiptSchema",
        "missingDataBehaviour",
        "syntheticVisualFallbackAllowed"
      ],
      "properties": {
        "modelManifestSchema": { "type": "string" },
        "scientificArtifactSchema": { "type": "string" },
        "validationReceiptSchema": { "type": "string" },
        "missingDataBehaviour": { "const": "typed-unavailable-error" },
        "syntheticVisualFallbackAllowed": { "const": false }
      }
    }
  }
}
